# Environment configuration for NexusMesh
# Firebase AI Logic (Gemini Chatbot & Cluster Reports) uses App Check attestation.
# GEMINI_API_KEY is used by the Gemini Interactions API (gemini-omni-1.2-flash) for video generation.
# Configure your key via the Secrets panel in Google AI Studio.
GEMINI_API_KEY=MY_GEMINI_API_KEY
